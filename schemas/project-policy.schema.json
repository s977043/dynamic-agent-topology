{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Project Policy",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "dat/v1alpha1"},
    "kind": {"const": "ProjectPolicy"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}},
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["rolloutStage"],
      "properties": {
        "routingPolicy": {"type": "string"},
        "escalationPolicy": {"type": "string"},
        "rolloutStage": {
          "enum": ["A0-assess", "A1-bind", "A2-observe", "A3-recommend", "A4-canary", "A5-dynamic"]
        },
        "escalation": {
          "type": "object",
          "properties": {
            "maxTopology": {"type": "string"},
            "maxAgents": {"type": "integer", "minimum": 1},
            "maxTransitions": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rolloutStage": {"enum": ["A3-recommend", "A4-canary", "A5-dynamic"]}
            }
          },
          "then": {"required": ["routingPolicy"]}
        },
        {
          "if": {
            "properties": {
              "rolloutStage": {"enum": ["A4-canary", "A5-dynamic"]}
            }
          },
          "then": {"required": ["escalationPolicy"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
