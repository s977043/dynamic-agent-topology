{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Project Binding",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "dat/v1alpha1"},
    "kind": {"const": "ProjectBinding"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}},
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["defaultTopology"],
      "properties": {
        "defaultTopology": {"type": "string"},
        "supportedTopologies": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
