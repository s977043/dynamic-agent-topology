{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(check-jsonschema *)",
      "Bash(python scripts/validate_*.py*)",
      "Bash(python scripts/test_*.py*)",
      "Bash(python scripts/pilot_status.py *)",
      "Bash(python scripts/summarize_experiment.py *)"
    ],
    "ask": [
      "Edit(/experiments/EXP-001-t0-vs-t1/experiment.yaml)",
      "Edit(/experiments/EXP-001-t0-vs-t1/pilot/freeze.yaml)",
      "Edit(/experiments/EXP-001-t0-vs-t1/pilot/pilot.yaml)",
      "Edit(/experiments/EXP-001-t0-vs-t1/pilot/run-matrix.yaml)",
      "Edit(/experiments/EXP-001-t0-vs-t1/pilot/prompts/**)",
      "Edit(/experiments/EXP-001-t0-vs-t1/scenarios/**)",
      "Edit(/fixtures/exp-001/**)",
      "Edit(/roles/verifier.yaml)",
      "Edit(/roles/worker.yaml)",
      "Edit(/schemas/evaluation.schema.json)",
      "Edit(/schemas/execution-trace.schema.json)",
      "Edit(/schemas/experiment.schema.json)",
      "Edit(/schemas/pilot-execution-attestation.schema.json)",
      "Edit(/schemas/pilot-run-meta.schema.json)",
      "Edit(/schemas/pilot.schema.json)",
      "Edit(/schemas/scenario-set.schema.json)",
      "Edit(/scripts/attest_pilot_run.py)",
      "Edit(/scripts/generate_pilot_matrix.py)",
      "Edit(/scripts/pilot_status.py)",
      "Edit(/scripts/prepare_pilot_run.py)",
      "Edit(/scripts/summarize_experiment.py)",
      "Edit(/scripts/validate_experiment_freeze.py)",
      "Edit(/scripts/validate_pilot.py)",
      "Edit(/topologies/canonical/T0_single_agent.yaml)",
      "Edit(/topologies/canonical/T1_worker_verifier.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_frozen_bash.py\""
          }
        ]
      }
    ]
  }
}
