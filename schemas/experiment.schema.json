{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Experiment",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "dat/v1alpha1"},
    "kind": {"const": "Experiment"},
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["question", "hypothesis", "conditions", "scenarioSets", "metrics", "controls", "decisionPolicy"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "conditions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "topologyRef"],
            "properties": {
              "id": {"type": "string"},
              "topologyRef": {"type": "string"},
              "description": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "runtimeScope": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "scenarioSets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["split", "path"],
            "properties": {
              "split": {"enum": ["train", "test", "regression"]},
              "path": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "metrics": {
          "type": "object",
          "required": ["primary"],
          "properties": {
            "primary": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "secondary": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "controls": {
          "type": "object",
          "required": ["sameRuntime", "sameModel", "sameEffort", "freshWorkspacePerRun"],
          "properties": {
            "sameRuntime": {"type": "boolean"},
            "sameModel": {"type": "boolean"},
            "sameEffort": {"type": "boolean"},
            "freshWorkspacePerRun": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "decisionPolicy": {
          "type": "object",
          "required": ["minimumRunsPerScenarioPerCondition", "criteria"],
          "properties": {
            "minimumRunsPerScenarioPerCondition": {"type": "integer", "minimum": 1},
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
