{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Pilot Run Metadata",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dat/v1alpha1"
    },
    "kind": {
      "const": "PilotRunMetadata"
    },
    "metadata": {
      "type": "object",
      "required": [
        "runId",
        "blockId",
        "scenario",
        "condition"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "repetition",
        "executionOrder",
        "workspaceId",
        "sessionId",
        "freshWorkspace",
        "freshSession",
        "crossRunFeedbackUsed",
        "promptSha256"
      ],
      "properties": {
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "executionOrder": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "freshWorkspace": {
          "const": true
        },
        "freshSession": {
          "const": true
        },
        "crossRunFeedbackUsed": {
          "const": false
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
