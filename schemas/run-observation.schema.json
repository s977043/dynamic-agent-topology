{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Run Observation",
  "description": "Observed Execution record for one everyday wave (docs/RUN_OBSERVATION_DESIGN.md). It carries no verdict. Cross-field rules and redaction checks live in scripts/validate_run_observation.py.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "startedAt",
    "endedAt",
    "wallClockMs",
    "goalRecorded",
    "outcome",
    "runtime",
    "model",
    "topologyEquivalent",
    "topologyBasis",
    "tasks",
    "agentInvocations",
    "artifacts",
    "reviews",
    "rework",
    "humanInterventions"
  ],
  "properties": {
    "apiVersion": {
      "const": "dat/v1alpha1"
    },
    "kind": {
      "const": "RunObservation"
    },
    "metadata": {
      "type": "object",
      "required": [
        "observationId",
        "project",
        "datVersion"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "datVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "startedAt": {
      "$ref": "#/$defs/timeOrUnknown"
    },
    "endedAt": {
      "$ref": "#/$defs/timeOrUnknown"
    },
    "wallClockMs": {
      "$ref": "#/$defs/countOrUnknown"
    },
    "goalRecorded": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "interrupted",
        "failed",
        "unknown"
      ]
    },
    "outcomeReason": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "name"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/agentRole"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        {
          "const": "unknown"
        }
      ]
    },
    "model": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "id"
            ],
            "properties": {
              "role": {
                "$ref": "#/$defs/agentRole"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        {
          "const": "unknown"
        }
      ]
    },
    "topologyEquivalent": {
      "enum": [
        "P0",
        "T0",
        "T1",
        "T2",
        "T3",
        "other",
        "unknown"
      ]
    },
    "topologyBasis": {
      "type": "object",
      "required": [
        "agentInvolved",
        "delegated",
        "verification",
        "independentReview",
        "specialistRole"
      ],
      "properties": {
        "agentInvolved": {
          "$ref": "#/$defs/triState"
        },
        "delegated": {
          "$ref": "#/$defs/triState"
        },
        "verification": {
          "$ref": "#/$defs/triState"
        },
        "verifierKind": {
          "enum": [
            "organizer",
            "separate-session",
            "separate-model",
            "human"
          ]
        },
        "independentReview": {
          "$ref": "#/$defs/triState"
        },
        "specialistRole": {
          "$ref": "#/$defs/triState"
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "required": [
        "total",
        "delegated"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/countOrUnknown"
        },
        "delegated": {
          "$ref": "#/$defs/countOrUnknown"
        }
      },
      "additionalProperties": false
    },
    "agentInvocations": {
      "$ref": "#/$defs/countOrUnknown"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "state"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "merged",
              "closed",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "reviewerKind",
              "role",
              "findings",
              "decision"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reviewerKind": {
                "enum": [
                  "same-session",
                  "separate-session",
                  "separate-model",
                  "human"
                ]
              },
              "role": {
                "enum": [
                  "advisory",
                  "verifier"
                ]
              },
              "findings": {
                "type": "object",
                "required": [
                  "blocking",
                  "nonBlocking"
                ],
                "properties": {
                  "blocking": {
                    "$ref": "#/$defs/countOrUnknown"
                  },
                  "nonBlocking": {
                    "$ref": "#/$defs/countOrUnknown"
                  }
                },
                "additionalProperties": false
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        {
          "const": "unknown"
        }
      ]
    },
    "rework": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/countOrUnknown"
        }
      },
      "additionalProperties": false
    },
    "humanInterventions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "count"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        {
          "const": "unknown"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "triState": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "agentRole": {
      "enum": [
        "organizer",
        "worker"
      ]
    },
    "countOrUnknown": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "unknown"
        }
      ]
    },
    "timeOrUnknown": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        {
          "const": "unknown"
        }
      ]
    }
  }
}
