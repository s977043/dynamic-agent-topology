{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Pilot Execution Attestation",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dat/v1alpha1"
    },
    "kind": {
      "const": "PilotExecutionAttestation"
    },
    "metadata": {
      "type": "object",
      "required": [
        "runId",
        "blockId",
        "scenario",
        "condition"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "sessionId",
        "freshSession",
        "crossRunFeedbackUsed",
        "runtime",
        "model",
        "effort",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "freshSession": {
          "type": "boolean"
        },
        "crossRunFeedbackUsed": {
          "type": "boolean"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
