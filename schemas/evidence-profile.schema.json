{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAT Evidence Profile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "gates"],
  "properties": {
    "apiVersion": {"const": "dat/v1alpha1"},
    "kind": {"const": "EvidenceProfile"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}},
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level"],
        "properties": {
          "id": {"type": "string"},
          "level": {"enum": ["deterministic", "observable", "judgment"]},
          "command": {"type": "string"},
          "description": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"level": {"const": "deterministic"}}},
            "then": {"required": ["command"]}
          },
          {
            "if": {"properties": {"level": {"enum": ["observable", "judgment"]}}},
            "then": {"required": ["description"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
